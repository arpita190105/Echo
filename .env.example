# Copy this file to `.env` and fill in your actual key.
# .env is where secrets live — never commit it to git.

# RapidAPI key for Indian Railway PNR status
# Get a free key at: https://rapidapi.com/ (search "IRCTC1" or "Indian Railway API", subscribe to the free tier)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_PNR_HOST=irctc1.p.rapidapi.com